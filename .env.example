APP_NAME=StudyFlow
ENVIRONMENT=development
# `make setup` replaces this value with a random local secret.
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=sqlite+aiosqlite:///./data/studyflow.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_HEALTH_TIMEOUT_SECONDS=3
# Server-only; the browser uses same-origin /api requests through Next.js.
BACKEND_URL=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1
